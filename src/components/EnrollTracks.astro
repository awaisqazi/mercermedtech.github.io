---
import '../styles/components/enroll.css';
import { site } from '../data/site';
import { enrollingPrograms, scheduledMedPrograms } from '../data/programs';
import type { Locale } from '../i18n';
import FundingLine from './FundingLine.astro';

export interface EnrollChip {
  icon: string;
  label: string;
  value?: string;
  /** Renders the campus address, linked to the map. */
  address?: boolean;
}

interface Props {
  locale: Locale;
  sectionTitle: string;
  med: {
    badge: string;
    titleAccent: string;
    subtitle: string;
    programsLabel: string;
    chips: EnrollChip[];
    actions: { href: string; label: string; style: 'primary' | 'secondary' }[];
    scheduleLabel: string;
  };
  tech: {
    badge: string;
    titleAccent: string;
    subtitle: string;
    chips: EnrollChip[];
    qualifyLabel: string;
    qualifyText: string;
    featuresLabel: string;
    features: { icon: string; label: string }[];
    actions: { href: string; label: string; style: 'tech' | 'tech-outline'; icon?: string }[];
  };
}

const { locale, sectionTitle, med, tech } = Astro.props;
const medEnrolling = enrollingPrograms.filter((program) => program.track === 'med');
const addressLines = [site.address.streetDisplay, `${site.address.city}, ${site.address.region} ${site.address.postalCode}`];
---

<section id="enroll" class="enroll-section" aria-labelledby="enroll-title">
  <div class="container">
    <h2 id="enroll-title" class="visually-hidden">{sectionTitle}</h2>

    <div class="enroll-tracks">
      <!-- Track 1: Med / health care programs -->
      <div class="enroll-card">
        <span class="enroll-badge enroll-badge--static">{med.badge}</span>
        <h3 class="enroll-title">
          <span class="text-gradient">{med.titleAccent}</span>
        </h3>
        <p class="enroll-subtitle">{med.subtitle}</p>

        <div class="enroll-programs" aria-label={med.programsLabel}>
          {
            medEnrolling.map((program) => (
              <div class="enroll-program">
                <span>{(program.listName ?? program.name)[locale]}</span>
              </div>
            ))
          }
        </div>

        <div class="enroll-grid">
          {
            med.chips.map((chip) => (
              <div class="enroll-chip">
                <div>
                  <div class="enroll-chip-label">{chip.label}</div>
                  <div class="enroll-chip-value">
                    {chip.address ? (
                      <a href={site.address.mapsUrl} target="_blank" rel="noopener noreferrer">
                        {addressLines[0]}
                        <br />
                        {addressLines[1]}
                      </a>
                    ) : (
                      chip.value
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <div class="enroll-actions">
          {
            med.actions.map((action) => (
              <a href={action.href} class={`btn btn-${action.style}`}>
                {action.label}
              </a>
            ))
          }
        </div>

        <div class="term-schedule" aria-label={med.scheduleLabel}>
          <div class="term-schedule-header">
            <span>{med.scheduleLabel}</span>
          </div>
          <ul class="term-list term-list--tba">
            {
              scheduledMedPrograms.map((program) => (
                <li>
                  <span class="term-name">{program.shortName[locale]}</span>
                  <span class="term-date">{program.statusLine?.[locale]}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Track 2: Tech / Digital Literacy Training -->
      <div class="enroll-card enroll-card--tech">
        <span class="enroll-badge enroll-badge--static">{tech.badge}</span>
        <h3 class="enroll-title">
          <span class="text-gradient">{tech.titleAccent}</span>
        </h3>
        <p class="enroll-subtitle">{tech.subtitle}</p>

        <div class="enroll-grid">
          {
            tech.chips.map((chip) => (
              <div class="enroll-chip">
                <div>
                  <div class="enroll-chip-label">{chip.label}</div>
                  <div class="enroll-chip-value">
                    {chip.address ? (
                      <a href={site.address.mapsUrl} target="_blank" rel="noopener noreferrer">
                        {addressLines[0]}
                        <br />
                        {addressLines[1]}
                      </a>
                    ) : (
                      chip.value
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <p class="enroll-qualify">
          <strong>{tech.qualifyLabel}</strong> {tech.qualifyText}
        </p>

        <div class="enroll-features" aria-label={tech.featuresLabel}>
          {
            tech.features.map((feature) => (
              <span>{feature.label}</span>
            ))
          }
        </div>

        <div class="enroll-actions">
          {
            tech.actions.map((action) => (
              <a href={action.href} class={`btn btn-${action.style}`}>
                {action.label}
              </a>
            ))
          }
        </div>

        <FundingLine locale={locale} />
      </div>
    </div>
  </div>
</section>
