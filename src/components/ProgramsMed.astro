---
import { medPrograms } from '../data/programs';
import ProgramCard from './ProgramCard.astro';
import Photo from './Photo.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  tag: string;
  heading: string;
  intro: string;
  detailsLabel: string;
  waitlistLabel: string;
  waitlistHref: string;
  /** Carousel labels. The programs are now a ruled catalogue list, so these
      are accepted for compatibility and not shown. */
  prevLabel?: string;
  nextLabel?: string;
  swipeLabel?: string;
  dotLabel?: string;
  /** Accessible name of the catalogue list. */
  trackLabel: string;
  notes: { heading: string; paragraphs: string[] };
  /** Alt text for the one lab photo beside the header. */
  imageAlt: string;
}

const { locale, tag, heading, intro, detailsLabel, waitlistLabel, waitlistHref, trackLabel, notes, imageAlt } =
  Astro.props;
---

<div id="programs-med" class="programs-group programs-group--med">
  <div class="container">
    <!-- The header, with one photo of the lab beside it (not one per program). -->
    <div class="programs-med-head">
      <div class="programs-group-header">
        <span class="eyebrow eyebrow--med">{tag}</span>
        <h3>{heading}</h3>
        <p>{intro}</p>
      </div>
      <Photo
        class="programs-med-photo"
        name="campus/lab-sink-3x2"
        widths={[480, 960, 1440]}
        width={1440}
        height={960}
        alt={imageAlt}
        sizes="(min-width: 900px) 400px, 92vw"
      />
    </div>

    <!-- The Med programs as a printed course catalogue: ruled rows, one
         program per row, hours in their own column. -->
    <ol class="catalogue" aria-label={trackLabel}>
      {
        medPrograms.map((program, index) => (
          <ProgramCard
            program={program}
            locale={locale}
            index={index + 1}
            detailsLabel={detailsLabel}
            waitlistLabel={waitlistLabel}
            waitlistHref={waitlistHref}
          />
        ))
      }
    </ol>

    <div class="data-source-notes">
      <h4>{notes.heading}</h4>
      {notes.paragraphs.map((text) => <p>{text}</p>)}
    </div>
  </div>
</div>
