---
import '../styles/components/contact.css';
import { BEST_TIME_VALUES } from '../data/programs';
import { dlt } from '../data/site';
import { t, type Locale } from '../i18n';

/**
 * SIGN-UP CONTRACT (external, do not improvise)
 * ---------------------------------------------
 * The Digital Literacy sign-up no longer posts to Google from the browser.
 * It posts to the mmt-signup Cloudflare Worker, which checks the Cloudflare
 * Turnstile token and only then forwards the answers to the Google Form. The
 * Google Form URL lives in the Worker's FORM_ACTION variable and must never
 * appear on this page again: a bot that can read the page can post to Google
 * directly, which is the whole reason the Worker exists.
 *
 * The entry.* names below are still the sign-up Google Form's names, because
 * the Worker forwards them through untouched. They have nothing to do with
 * the homepage contact form in ContactForm.astro: do not copy an entry id
 * from one file into the other.
 *
 * Every dropdown here is a Google Forms DROPDOWN, which silently throws away
 * any value it does not recognise. So the VALUE sent on is always the English
 * string the form knows, in both languages, while the reader sees a
 * translated LABEL. County names are the same word in both languages.
 *
 * scripts/check-form-contract.mjs (npm run check:form) checks every built page
 * against both contracts, including that the Google Form URL is absent here.
 */
const WORKER_ENDPOINT = 'https://mmt-signup.mercermedtech.workers.dev';

/** Public Turnstile site key. The secret key lives only in the Worker. */
const TURNSTILE_SITEKEY = '0x4AAAAAAFABG_uSmI7QN2sd';

const FIELD = {
  name: 'entry.610321898',
  phone: 'entry.845307859',
  email: 'entry.1745544463',
  county: 'entry.334657821',
  benefits: 'entry.1320551453',
  language: 'entry.1571243070',
  attend: 'entry.648594530',
  bestTime: 'entry.303849646',
  referral: 'entry.1699212155',
  message: 'entry.1074735478',
};

/** The value Google keeps for a county that is not one of the seven. */
const OTHER_COUNTY = 'Other';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const f = d.dltSignup.form;
const c = d.home.contact;

const counties = [
  ...dlt.counties.map((county) => ({ value: county, label: county })),
  { value: OTHER_COUNTY, label: f.countyOther },
];
const benefits = [
  { value: 'Yes', label: f.benefitsYes },
  { value: 'No', label: f.benefitsNo },
  { value: 'Not sure', label: f.benefitsNotSure },
];
const languages = [
  { value: 'English', label: f.languageEnglish },
  { value: 'Spanish', label: f.languageSpanish },
];
const attendance = [
  { value: 'Online', label: f.attendOnline },
  { value: 'In person in Lawrenceville', label: f.attendInPerson },
  { value: 'Either', label: f.attendEither },
];
// The best-time labels are the ones the contact form already uses, so the
// reader meets the same four words everywhere on the site.
const bestTimes = BEST_TIME_VALUES.map((value, index) => ({
  value,
  label: c.bestTimeOptions[index] ?? value,
}));
---

<div class="contact-card signup-card">
  <form id="dlt-signup-form" class="contact-form" action={WORKER_ENDPOINT} method="post">
    <div class="form-row">
      <label class="form-field">
        <span class="form-label">{f.nameLabel} <span class="req" aria-hidden="true">*</span></span>
        <input type="text" name={FIELD.name} required autocomplete="name" placeholder={f.namePlaceholder} />
      </label>
      <label class="form-field">
        <span class="form-label">{f.phoneLabel} <span class="req" aria-hidden="true">*</span></span>
        <input
          type="tel"
          name={FIELD.phone}
          required
          autocomplete="tel"
          placeholder={f.phonePlaceholder}
          pattern="[0-9\(\)\-\s\+]{7,}"
        />
      </label>
    </div>

    <label class="form-field">
      <span class="form-label">{f.emailLabel} <span class="optional">({f.optional})</span></span>
      <input type="email" name={FIELD.email} autocomplete="email" placeholder={f.emailPlaceholder} />
    </label>

    <div class="form-row">
      <label class="form-field">
        <span class="form-label">{f.countyLabel} <span class="req" aria-hidden="true">*</span></span>
        <select name={FIELD.county} required>
          <option value="" disabled selected>{f.pickOne}</option>
          {counties.map((county) => <option value={county.value}>{county.label}</option>)}
        </select>
      </label>
      <label class="form-field">
        <span class="form-label">{f.benefitsLabel} <span class="req" aria-hidden="true">*</span></span>
        <select name={FIELD.benefits} required>
          <option value="" disabled selected>{f.pickOne}</option>
          {benefits.map((choice) => <option value={choice.value}>{choice.label}</option>)}
        </select>
      </label>
    </div>

    <div class="form-row">
      <label class="form-field">
        <span class="form-label">{f.languageLabel} <span class="req" aria-hidden="true">*</span></span>
        <select name={FIELD.language} required>
          <option value="" disabled selected>{f.pickOne}</option>
          {languages.map((choice) => <option value={choice.value}>{choice.label}</option>)}
        </select>
      </label>
      <label class="form-field">
        <span class="form-label">{f.attendLabel} <span class="req" aria-hidden="true">*</span></span>
        <select name={FIELD.attend} required>
          <option value="" disabled selected>{f.pickOne}</option>
          {attendance.map((choice) => <option value={choice.value}>{choice.label}</option>)}
        </select>
      </label>
    </div>

    <div class="form-row">
      <label class="form-field">
        <span class="form-label">{f.bestTimeLabel} <span class="optional">({f.optional})</span></span>
        <select name={FIELD.bestTime}>
          <option value="" disabled selected>{f.bestTimePlaceholder}</option>
          {bestTimes.map((choice) => <option value={choice.value}>{choice.label}</option>)}
        </select>
      </label>
      <label class="form-field">
        <span class="form-label">{f.referralLabel} <span class="optional">({f.optional})</span></span>
        <input type="text" name={FIELD.referral} placeholder={f.referralPlaceholder} />
      </label>
    </div>

    <label class="form-field">
      <span class="form-label">{f.messageLabel} <span class="optional">({f.optional})</span></span>
      <textarea name={FIELD.message} rows="4" placeholder={f.messagePlaceholder}></textarea>
    </label>

    <!--
      Turnstile draws itself into this box and drops a hidden
      cf-turnstile-response input into the form. It is inside the form on
      purpose: that hidden input is what the Worker checks.
    -->
    <div
      class="signup-turnstile"
      id="signup-turnstile"
      data-sitekey={TURNSTILE_SITEKEY}
      data-language={locale}>
    </div>
    <p class="signup-security-note" id="signup-turnstile-note" hidden>{f.securityUnavailable}</p>

    <div class="form-consent">
      <label>
        <input type="checkbox" required />
        <span>{f.consent}</span>
      </label>
    </div>

    <button type="submit" class="btn btn-primary form-submit">
      <span class="form-submit-label">{f.submit}</span>
      <i class="fas fa-paper-plane" aria-hidden="true"></i>
    </button>

    <div
      class="form-success"
      role="status"
      aria-live="polite"
      hidden
      data-success-title={f.successTitle}
      data-success-body={f.successBody}
      data-error-title={f.errorTitle}
      data-error-body={f.errorBody}
      data-security-body={f.securityIncomplete}
      data-submit-label={f.submit}
      data-sending-label={f.sending}
    >
      <i class="fas fa-check-circle" aria-hidden="true"></i>
      <div>
        <strong>{f.successTitle}</strong>
        <span>{f.successBody}</span>
      </div>
    </div>
  </form>
</div>

<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>

<script>
  /*
   * The sign-up posts to the mmt-signup Worker with fetch, so the reader stays
   * on the page and the Google Form URL never reaches the browser. The Worker
   * answers {ok:true} or {ok:false,error}. Turnstile guards the submit button:
   * no token, no send.
   */
  const WORKER_ENDPOINT = 'https://mmt-signup.mercermedtech.workers.dev';
  const TIMEOUT_MS = 12000;
  const WAIT_FOR_SCRIPT_MS = 10000;

  const form = document.getElementById('dlt-signup-form') as HTMLFormElement | null;
  const host = document.getElementById('signup-turnstile');
  const note = document.getElementById('signup-turnstile-note');

  if (form && host) {
    const submitBtn = form.querySelector<HTMLButtonElement>('.form-submit');
    const message = form.querySelector<HTMLElement>('.form-success');

    if (submitBtn && message) {
      const labelEl = form.querySelector<HTMLElement>('.form-submit-label');
      const icon = message.querySelector('i');
      const strong = message.querySelector('strong');
      const span = message.querySelector('span');
      const data = message.dataset;

      let token = '';
      let widgetId: string | undefined;
      let isSubmitting = false;

      // Only JavaScript disables the button, so a reader without JavaScript
      // keeps the plain form post to the Worker.
      submitBtn.disabled = true;

      const setBusy = (busy: boolean) => {
        isSubmitting = busy;
        submitBtn.disabled = busy || !token;
        submitBtn.classList.toggle('is-loading', busy);
        if (labelEl) {
          const text = busy ? data.sendingLabel : data.submitLabel;
          if (text) labelEl.textContent = text;
        }
      };

      const show = (title: string, body: string, isError: boolean) => {
        if (strong) strong.textContent = title;
        if (span) span.textContent = body;
        if (icon) {
          icon.classList.toggle('fa-check-circle', !isError);
          icon.classList.toggle('fa-circle-exclamation', isError);
        }
        message.classList.toggle('is-error', isError);
        message.hidden = false;
        message.classList.add('is-visible');
        message.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      const showError = (body?: string) => {
        show(data.errorTitle || '', body || data.errorBody || '', true);
      };

      /* ---------- Turnstile ---------- */

      const turnstileApi = () => (window as any).turnstile;

      const renderWidget = () => {
        widgetId = turnstileApi().render(host, {
          sitekey: host.dataset.sitekey,
          theme: 'light',
          language: host.dataset.language === 'es' ? 'es' : 'en',
          'response-field': true,
          callback: (value: string) => {
            token = value;
            if (!isSubmitting) submitBtn.disabled = false;
          },
          'expired-callback': () => {
            token = '';
            submitBtn.disabled = true;
          },
          'error-callback': () => {
            token = '';
            submitBtn.disabled = true;
          },
        });
      };

      const startedAt = Date.now();
      const waitForTurnstile = () => {
        const api = turnstileApi();
        if (api && typeof api.render === 'function') {
          renderWidget();
          return;
        }
        if (Date.now() - startedAt > WAIT_FOR_SCRIPT_MS) {
          // Blocked or offline: say so instead of letting a send fail silently.
          if (note) note.hidden = false;
          return;
        }
        window.setTimeout(waitForTurnstile, 150);
      };
      waitForTurnstile();

      /* ---------- submit ---------- */

      form.addEventListener('submit', async (event) => {
        if (!form.checkValidity()) return; // the browser shows its own message
        event.preventDefault();
        if (isSubmitting) return;

        if (!token) {
          showError(data.securityBody);
          return;
        }

        setBusy(true);
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), TIMEOUT_MS);

        try {
          const body = new URLSearchParams(
            new FormData(form) as unknown as Record<string, string>
          );
          const response = await fetch(WORKER_ENDPOINT, {
            method: 'POST',
            mode: 'cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body,
            signal: controller.signal,
          });
          const result = await response.json().catch(() => null);

          if (response.ok && result && result.ok === true) {
            form.reset();
            token = '';
            if (widgetId !== undefined) turnstileApi()?.reset(widgetId);
            show(data.successTitle || '', data.successBody || '', false);
          } else {
            showError();
          }
        } catch {
          showError();
        } finally {
          window.clearTimeout(timer);
          setBusy(false);
        }
      });
    }
  }
</script>
