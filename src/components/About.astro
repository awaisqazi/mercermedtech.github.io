---
import Photo from './Photo.astro';

interface Props {
  heading: string;
  paragraphs: string[];
  /** The classroom photo. */
  imageAlt: string;
  /** The lab and break room doors. */
  doorsAlt: string;
  actions: { href: string; label: string; style: 'primary' | 'tech-outline' }[];
}

const { heading, paragraphs, imageAlt, doorsAlt, actions } = Astro.props;
---

<section id="about" class="section-padding about-section">
  <div class="container">
    <div class="hero-grid">
      <!-- Proof of place: two small photos of the campus, side by side. -->
      <div class="about-photos">
        <Photo
          name="campus/doors-lab-breakroom-4x5"
          widths={[480, 960, 1440]}
          width={1440}
          height={1800}
          alt={doorsAlt}
          sizes="(min-width: 969px) 270px, 46vw"
        />
        <Photo
          name="campus/classroom-screen-4x5"
          widths={[480, 960]}
          width={960}
          height={1200}
          alt={imageAlt}
          sizes="(min-width: 969px) 270px, 46vw"
        />
      </div>
      <div class="hero-content">
        <h2 class="section-title">{heading}</h2>
        {paragraphs.map((text) => <p>{text}</p>)}
        <div class="hero-actions hero-actions--spaced">
          {actions.map((action) => <a href={action.href} class={`btn btn-${action.style}`}>{action.label}</a>)}
        </div>
      </div>
    </div>
  </div>
</section>
