---
import { programById } from '../data/programs';
import type { Locale } from '../i18n';
import FundingLine from './FundingLine.astro';

interface Props {
  locale: Locale;
  tag: string;
  heading: string;
  intro: string;
  /** Chips under the description. */
  chips: string[];
  modulesLabel: string;
  modules: { icon: string; label: string }[];
  sessionsLine: string;
  actions: { href: string; label: string; style: 'tech' | 'tech-outline'; icon?: string }[];
}

const { locale, tag, heading, intro, chips, modulesLabel, modules, sessionsLine, actions } = Astro.props;
const program = programById('digital-literacy-training')!;
---

<div id="programs-tech" class="programs-group programs-group--tech">
  <div class="programs-group-header">
    <span class="track-tag track-tag--tech">{tag}</span>
    <h3>{heading}</h3>
    <p>{intro}</p>
  </div>

  <article class="tech-card tech-card--feature">
    <div class="tech-card-icon"><i class={program.icon} aria-hidden="true"></i></div>
    <span class="tech-card-badge">
      <i class={program.badgeIcon ?? 'fas fa-tag'} aria-hidden="true"></i>
      {program.badge?.[locale]}
    </span>
    <h4>{program.name[locale]}</h4>
    <p>{program.summary[locale]}</p>
    <ul class="tech-card-list">
      {chips.map((chip) => <li>{chip}</li>)}
    </ul>

    <p class="tech-card-subhead">{modulesLabel}</p>
    <ul class="tech-card-modules">
      {
        modules.map((module) => (
          <li>
            <i class={module.icon} aria-hidden="true" /> {module.label}
          </li>
        ))
      }
    </ul>

    <p class="tech-card-sessions">
      <i class="fas fa-calendar-check" aria-hidden="true"></i>
      {sessionsLine}
    </p>

    <div class="tech-card-actions">
      {
        actions.map((action) => (
          <a href={action.href} class={`btn btn-${action.style}`}>
            {action.icon && <i class={action.icon} aria-hidden="true" />}
            {action.label}
          </a>
        ))
      }
    </div>

    <FundingLine locale={locale} class="tech-card-funding" />
  </article>
</div>
