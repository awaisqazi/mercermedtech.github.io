---
import Icon from './Icon.astro';
import '../styles/components/contact.css';
import '../styles/components/signup.css';
import { site, tracks } from '../data/site';
import { formPrograms, NOT_SURE_OPTION, BEST_TIME_VALUES } from '../data/programs';
import { t, type Locale } from '../i18n';

/**
 * GOOGLE FORM CONTRACT (external, do not improvise)
 * -------------------------------------------------
 * The answers end up in the contact inquiry Google Form, but not from the
 * browser: like the Digital Literacy interest form (DltInterestForm.astro),
 * this form posts to the mmt-signup Cloudflare Worker (/inquiry-submit),
 * which checks the Cloudflare Turnstile token and only then forwards the
 * answers to Google. The Google Form URL lives in the Worker's
 * FORM_ACTION_INQUIRY variable and must never appear on this page: a bot that
 * can read the page could post to Google directly. Once Google has the
 * answers, the Worker also copies them to the staff portal's inbox.
 *
 * Every entry.* name below must match the live Google Form; the Worker
 * forwards them untouched. The program dropdown is a Google Forms DROPDOWN:
 * it silently rejects any value that is not one of its own choices. So on
 * Spanish pages the reader sees a Spanish LABEL while the VALUE sent to Google
 * stays the English string from programs.ts "formOption". The same goes for
 * the best-time-to-call list.
 * scripts/check-form-contract.mjs (npm run check:form) checks every built page.
 * Notes and the full entry id map: docs/inquiry-form.md.
 */
const WORKER_ENDPOINT = 'https://mmt-signup.mercermedtech.workers.dev/inquiry-submit';

/** Public Turnstile site key, the same widget as the other public forms. The secret lives only in the Worker. */
const TURNSTILE_SITEKEY = '0x4AAAAAAFABG_uSmI7QN2sd';
const FIELD = {
  name: 'entry.500866520',
  phone: 'entry.377183870',
  email: 'entry.561406325',
  program: 'entry.358026590',
  bestTime: 'entry.1429591353',
  message: 'entry.1375584749',
};

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale).home.contact;
const groups = (['med', 'tech'] as const).map((track) => ({
  label: tracks[track].label,
  programs: formPrograms.filter((program) => program.track === track),
}));
const addressLine2 = `${site.address.city}, ${site.address.region} ${site.address.postalCode}`;
const bestTimeChoices = BEST_TIME_VALUES.map((value, index) => ({
  value,
  label: c.bestTimeOptions[index] ?? value,
}));
---

<section id="contact" class="contact-section section-padding block-med" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-intro">
        <span class="eyebrow contact-eyebrow">{c.eyebrow}</span>
        <h2 id="contact-title" class="section-title bracketed">{c.heading}</h2>
        <p>{c.intro}</p>

        <ul class="contact-direct">
          <li>
            <Icon name="phone" />
            <div>
              <div class="contact-direct-label">{c.callLabel}</div>
              <a href={site.phone.href}>{site.phone.display}</a>
            </div>
          </li>
          <li>
            <Icon name="mail" />
            <div>
              <div class="contact-direct-label">{c.emailLabel}</div>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          </li>
          <li>
            <Icon name="map-pin" />
            <div>
              <div class="contact-direct-label">{c.visitLabel}</div>
              <a href={site.address.mapsUrl} target="_blank" rel="noopener noreferrer">
                {site.address.streetDisplay}<br />{addressLine2}
              </a>
            </div>
          </li>
        </ul>
      </div>

      <div class="contact-card panel-paper">
        <form id="request-info-form" class="contact-form" action={WORKER_ENDPOINT} method="post">
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">{c.nameLabel}&nbsp;<span class="req" aria-hidden="true">*</span></span>
              <input type="text" name={FIELD.name} required autocomplete="name" placeholder={c.namePlaceholder} />
            </label>
            <label class="form-field">
              <span class="form-label">{c.phoneLabel}&nbsp;<span class="req" aria-hidden="true">*</span></span>
              <input
                type="tel"
                name={FIELD.phone}
                required
                autocomplete="tel"
                placeholder={c.phonePlaceholder}
                pattern="[0-9\(\)\-\s\+]{7,}"
              />
            </label>
          </div>

          <label class="form-field">
            <span class="form-label">{c.emailFieldLabel}&nbsp;<span class="req" aria-hidden="true">*</span></span>
            <input type="email" name={FIELD.email} required autocomplete="email" placeholder={c.emailPlaceholder} />
          </label>

          <div class="form-row">
            <label class="form-field">
              <span class="form-label">{c.programLabel}</span>
              <select name={FIELD.program} required>
                <option value="" disabled selected>{c.programPlaceholder}</option>
                {
                  groups.map((group) => (
                    <optgroup label={group.label}>
                      {group.programs.map((program) => (
                        <option value={program.formOption} data-program={program.id}>
                          {program.name[locale]}
                        </option>
                      ))}
                    </optgroup>
                  ))
                }
                <option value={NOT_SURE_OPTION}>{c.notSureOption}</option>
              </select>
            </label>
            <label class="form-field">
              <span class="form-label">{c.bestTimeLabel}</span>
              <select name={FIELD.bestTime}>
                <option value="" disabled selected>{c.bestTimePlaceholder}</option>
                {bestTimeChoices.map((choice) => <option value={choice.value}>{choice.label}</option>)}
              </select>
            </label>
          </div>

          <label class="form-field">
            <span class="form-label">{c.messageLabel} <span class="optional">({c.optional})</span></span>
            <textarea name={FIELD.message} rows="4" placeholder={c.messagePlaceholder}></textarea>
          </label>

          <div class="form-consent">
            <label>
              <input type="checkbox" required />
              <span>{c.consent}</span>
            </label>
          </div>

          <!-- Honeypot: hidden from people; the Worker drops any post that fills it. -->
          <div class="contact-honeypot" aria-hidden="true">
            <label>{c.honeypotLabel} <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <!--
            Turnstile draws itself into this box and drops a hidden
            cf-turnstile-response input into the form, which the Worker checks.
          -->
          <div class="signup-turnstile" data-turnstile data-sitekey={TURNSTILE_SITEKEY} data-language={locale}></div>
          <p class="signup-security-note" data-turnstile-note hidden>{c.securityUnavailable}</p>

          <button type="submit" class="btn btn-primary form-submit">
            <span class="form-submit-label">{c.submit}</span>
          </button>

          <div
            class="form-success"
            role="status"
            aria-live="polite"
            hidden
            data-success-title={c.successTitle}
            data-success-body={c.successBody}
            data-error-title={c.errorTitle}
            data-error-body={c.errorBody}
            data-security-body={c.securityIncomplete}
            data-submit-label={c.submit}
            data-sending-label={c.sending}
          >
            <Icon name="check-circle" class="status-ok" />
            <Icon name="alert-circle" class="status-err" hidden />
            <div>
              <strong>{c.successTitle}</strong>
              <span>{c.successBody}</span>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  /*
   * Same technique as DltInterestForm.astro: the form posts to the mmt-signup
   * Worker with fetch, so the reader stays on the page and the Google Form
   * URL never reaches the browser. The Worker answers {ok:true} or
   * {ok:false,error}. Turnstile guards the submit button: no token, no send.
   */
  const WORKER_ENDPOINT = 'https://mmt-signup.mercermedtech.workers.dev/inquiry-submit';
  const TURNSTILE_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
  const TIMEOUT_MS = 12000;
  const WAIT_FOR_SCRIPT_MS = 10000;

  const form = document.getElementById('request-info-form') as HTMLFormElement | null;
  const host = form?.querySelector<HTMLElement>('[data-turnstile]');
  const note = form?.querySelector<HTMLElement>('[data-turnstile-note]');

  if (form && host) {
    const submitBtn = form.querySelector<HTMLButtonElement>('.form-submit');
    const message = form.querySelector<HTMLElement>('.form-success');
    const labelEl = form.querySelector<HTMLElement>('.form-submit-label');

    // Arriving with ?program=<id> (from a program page, or from the Digital
    // Literacy page) preselects that option, so the reader does not have to
    // find it themselves.
    const requested = new URLSearchParams(window.location.search).get('program');
    if (requested) {
      const select = form.querySelector<HTMLSelectElement>('select[name="entry.358026590"]');
      const alias = requested === 'digital-literacy' ? 'digital-literacy-training' : requested;
      const option = select?.querySelector<HTMLOptionElement>(`option[data-program="${CSS.escape(alias)}"]`);
      if (select && option) select.value = option.value;
    }

    // The home page also carries the interest form, which loads the Turnstile
    // script with its own tag. Add the script only when no form on the page
    // has, so it loads once; each form then renders its own widget.
    if (!document.querySelector('script[src^="https://challenges.cloudflare.com/turnstile/v0/api.js"]')) {
      const tag = document.createElement('script');
      tag.src = TURNSTILE_SRC;
      tag.async = true;
      document.head.appendChild(tag);
    }

    if (submitBtn && message) {
      const okIcon = message.querySelector('.status-ok');
      const errorIcon = message.querySelector('.status-err');
      const strong = message.querySelector('strong');
      const span = message.querySelector('span');
      const data = message.dataset;

      let token = '';
      let widgetId: string | undefined;
      let isSubmitting = false;

      // Only JavaScript disables the button, so a reader without JavaScript
      // keeps the plain form post to the Worker.
      submitBtn.disabled = true;

      const setBusy = (busy: boolean) => {
        isSubmitting = busy;
        submitBtn.disabled = busy || !token;
        submitBtn.classList.toggle('is-loading', busy);
        if (labelEl) {
          const text = busy ? data.sendingLabel : data.submitLabel;
          if (text) labelEl.textContent = text;
        }
      };

      const show = (title: string, body: string, isError: boolean) => {
        if (strong) strong.textContent = title;
        if (span) span.textContent = body;
        okIcon?.toggleAttribute('hidden', isError);
        errorIcon?.toggleAttribute('hidden', !isError);
        message.classList.toggle('is-error', isError);
        message.hidden = false;
        message.classList.add('is-visible');
        message.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      const showError = (body?: string) => {
        show(data.errorTitle || '', body || data.errorBody || '', true);
      };

      /* ---------- Turnstile ---------- */

      const turnstileApi = () => (window as any).turnstile;

      const renderWidget = () => {
        widgetId = turnstileApi().render(host, {
          sitekey: host.dataset.sitekey,
          theme: 'light',
          language: host.dataset.language === 'es' ? 'es' : 'en',
          // The standard widget is 300px wide and would run past a narrow
          // phone card; below that it switches to the compact one (150px).
          size: host.clientWidth < 300 ? 'compact' : 'flexible',
          'response-field': true,
          callback: (value: string) => {
            token = value;
            if (!isSubmitting) submitBtn.disabled = false;
          },
          'expired-callback': () => {
            token = '';
            submitBtn.disabled = true;
          },
          'error-callback': () => {
            token = '';
            submitBtn.disabled = true;
          },
        });
      };

      const startedAt = Date.now();
      const waitForTurnstile = () => {
        const api = turnstileApi();
        if (api && typeof api.render === 'function') {
          renderWidget();
          return;
        }
        if (Date.now() - startedAt > WAIT_FOR_SCRIPT_MS) {
          // Blocked or offline: say so instead of letting a send fail silently.
          if (note) note.hidden = false;
          return;
        }
        window.setTimeout(waitForTurnstile, 150);
      };
      waitForTurnstile();

      /* ---------- submit ---------- */

      form.addEventListener('submit', async (event) => {
        if (!form.checkValidity()) {
          event.preventDefault();
          form.reportValidity();
          return;
        }
        event.preventDefault();
        if (isSubmitting) return;

        if (!token) {
          showError(data.securityBody);
          return;
        }

        setBusy(true);
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), TIMEOUT_MS);

        try {
          const body = new URLSearchParams(
            new FormData(form) as unknown as Record<string, string>
          );
          const response = await fetch(WORKER_ENDPOINT, {
            method: 'POST',
            mode: 'cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body,
            // The Worker reads the page path (and so the language) from the
            // Referer; by default a cross-origin request sends only the origin.
            referrerPolicy: 'no-referrer-when-downgrade',
            signal: controller.signal,
          });
          const result = await response.json().catch(() => null);

          if (response.ok && result && result.ok === true) {
            form.reset();
            token = '';
            if (widgetId !== undefined) turnstileApi()?.reset(widgetId);
            show(data.successTitle || '', data.successBody || '', false);
          } else {
            showError();
          }
        } catch {
          showError();
        } finally {
          window.clearTimeout(timer);
          setBusy(false);
        }
      });
    }
  }
</script>
