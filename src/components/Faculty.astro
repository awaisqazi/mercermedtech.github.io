---
import '../styles/components/faculty.css';

interface Props {
  heading: string;
  intro: string;
  people: { name: string; role: string; bio: string; icon: string }[];
}

const { heading, intro, people } = Astro.props;
---

<section id="faculty" class="section-padding bg-surface-1">
  <div class="container">
    <div class="section-header text-center">
      <h2>{heading}</h2>
      <p class="text-muted">{intro}</p>
    </div>
    <div class="faculty-wrapper">
      {
        people.map((person) => (
          <div class="program-card faculty-card text-center">
            <div class="program-icon faculty-icon">
              <i class={person.icon} aria-hidden="true" />
            </div>
            <h3>{person.name}</h3>
            <p class="text-primary font-bold mb-2">{person.role}</p>
            <p>{person.bio}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
