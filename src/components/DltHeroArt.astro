---
/**
 * Flat line drawing in the Tech colours: a laptop and a certificate. No
 * gradients, no floating dots, no photography. Inline so it inherits nothing.
 */
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<svg class="dl-hero-art" viewBox="0 0 440 340" role="img" aria-label={label}>
  <!-- laptop lid -->
  <rect x="50" y="56" width="300" height="196" rx="8" fill="#FFFFFF" stroke="#18222D" stroke-width="2"></rect>
  <rect x="66" y="72" width="268" height="164" rx="2" fill="#E7ECFD"></rect>

  <!-- screen content: a document with lines of text -->
  <rect x="86" y="92" width="96" height="10" fill="#2B44A8"></rect>
  <rect x="86" y="116" width="168" height="5" fill="#3B5BDB" opacity="0.55"></rect>
  <rect x="86" y="130" width="148" height="5" fill="#3B5BDB" opacity="0.55"></rect>
  <rect x="86" y="144" width="160" height="5" fill="#3B5BDB" opacity="0.55"></rect>
  <rect x="86" y="170" width="112" height="5" fill="#3B5BDB" opacity="0.55"></rect>
  <rect x="86" y="184" width="132" height="5" fill="#3B5BDB" opacity="0.55"></rect>
  <rect x="86" y="208" width="60" height="12" rx="2" fill="#3B5BDB"></rect>

  <!-- laptop base -->
  <path d="M24 252 H376 L364 270 H36 Z" fill="#FFFFFF" stroke="#18222D" stroke-width="2" stroke-linejoin="round"></path>
  <line x1="176" y1="259" x2="224" y2="259" stroke="#18222D" stroke-width="2" stroke-linecap="round"></line>

  <!-- certificate -->
  <rect x="290" y="150" width="122" height="150" rx="4" fill="#FFFFFF" stroke="#18222D" stroke-width="2"></rect>
  <rect x="306" y="168" width="90" height="3" fill="#3B5BDB"></rect>
  <rect x="306" y="184" width="70" height="4" fill="#18222D" opacity="0.7"></rect>
  <rect x="306" y="196" width="82" height="4" fill="#18222D" opacity="0.35"></rect>
  <rect x="306" y="206" width="62" height="4" fill="#18222D" opacity="0.35"></rect>
  <circle cx="351" cy="252" r="20" fill="none" stroke="#3B5BDB" stroke-width="3"></circle>
  <path d="M341 252 l7 7 l13 -14" fill="none" stroke="#3B5BDB" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
