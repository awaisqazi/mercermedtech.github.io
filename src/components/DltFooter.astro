---
/**
 * Minimal Tech-track footer. NJDOL rule: the only outbound site link is the
 * plain "Mercer Med Tech home" link. No program cross-sell of any kind. The
 * student login goes to this program's own class site, so it is not a
 * cross-sell.
 */
import { site } from '../data/site';
import { localePath, t, type Locale } from '../i18n';
import FundingLine from './FundingLine.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
---

<footer class="dl-footer">
  <div class="container">
    <FundingLine locale={locale} class="dl-footer-funding" />

    <p>{d.footer.licensingLine}</p>
    <p class="dl-footer-contact">
      <span>{site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}</span>
      <a href={site.phone.href}>{site.phone.display}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p class="dl-footer-links">
      <a href={localePath(locale, '/')}>{d.footer.homeLink}</a>
      <span aria-hidden="true">·</span>
      <a href={site.classSite.url} target="_blank" rel="noopener">{d.footer.studentLogin}</a>
    </p>

    <div class="dl-footer-bottom">
      <p>{site.copyright}</p>
    </div>
  </div>
</footer>
