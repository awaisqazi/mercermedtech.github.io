---
import '../styles/components/grants.css';
import { Image } from 'astro:assets';
import grantsImage from '../assets/images/pic04.png';
import type { Locale } from '../i18n';
import FundingLine from './FundingLine.astro';

interface Props {
  locale: Locale;
  med: {
    heading: string;
    body: string;
    bullets: { icon: string; label: string }[];
    loanHeading: string;
    loanBody: string;
    loanInvite: string;
    ctaHref: string;
    ctaLabel: string;
  };
  tech: {
    heading: string;
    body: string;
    ctaHref: string;
    ctaLabel: string;
  };
}

const { locale, med, tech } = Astro.props;
---

<section id="grants" class="section-padding bg-surface-1">
  <div class="container">
    <!-- (a) Funding for the Med programs -->
    <div class="hero-grid">
      <div class="hero-image-wrapper">
        <Image
          src={grantsImage}
          alt=""
          aria-hidden="true"
          class="hero-image grants-image"
          widths={[480, 800, 1200]}
          sizes="(max-width: 968px) 92vw, 600px"
          loading="lazy"
        />
      </div>
      <div class="hero-content">
        <h2 class="section-title">{med.heading}</h2>
        <p>{med.body}</p>

        <ul class="fa-ul grants-list">
          {
            med.bullets.map((bullet) => (
              <li>
                <span class="fa-li"><i class={`${bullet.icon} text-primary`} aria-hidden="true" /></span>
                {bullet.label}
              </li>
            ))
          }
        </ul>

        <div class="financial-aid-footer">
          <h4>{med.loanHeading}</h4>
          <p class="loan-note">{med.loanBody}</p>
          <p class="loan-invite">{med.loanInvite}</p>
          <a href={med.ctaHref} class="btn btn-primary">{med.ctaLabel}</a>
        </div>
      </div>
    </div>

    <!-- (b) Digital Literacy Training is grant funded -->
    <div class="grants-block grants-divider">
      <h3>{tech.heading}</h3>
      <p>{tech.body}</p>
      <FundingLine locale={locale} />
      <a href={tech.ctaHref} class="btn btn-tech">{tech.ctaLabel}</a>
    </div>
  </div>
</section>
