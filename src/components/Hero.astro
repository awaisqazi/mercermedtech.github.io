---
import '../styles/components/hero.css';
import Lockup from './Lockup.astro';

export interface TrustItem {
  icon: string;
  label: string;
}

export interface TrackPanel {
  track: 'med' | 'tech';
  label: string;
  heading: string;
  /** The one-line pitch. */
  body: string;
  /** The track's status line ("Enrolling year-round"). */
  status: string;
  ctaHref: string;
  ctaLabel: string;
}

interface Props {
  headingBefore: string;
  headingAccent: string;
  headingAfter: string;
  lead: string;
  trust: TrustItem[];
  trustLabel: string;
  /** Med panel first, Tech second. The order rule is not negotiable. */
  panels: TrackPanel[];
  quietBefore: string;
  quietLinkLabel: string;
  quietLinkHref: string;
  quietAfter: string;
}

const {
  headingBefore,
  headingAccent,
  headingAfter,
  lead,
  trust,
  trustLabel,
  panels,
  quietBefore,
  quietLinkLabel,
  quietLinkHref,
  quietAfter,
} = Astro.props;
---

<section id="hero" class="hero">
  <div class="container hero-head">
    <Lockup variant="eyebrow" />
    <h1>{headingBefore}<span class="bracket-pair">{headingAccent}</span>{headingAfter}</h1>
    <div class="hero-intro">
      <p class="hero-lead">{lead}</p>
      <ul class="hero-trust" aria-label={trustLabel}>
        {trust.map((item) => <li>{item.label}</li>)}
      </ul>
    </div>
  </div>

  <!-- The two paths as full-bleed colour blocks: Med (teal) left, Tech
       (indigo) right. Stacked on phones, Med first. Never reordered. -->
  <div class="paths">
    {
      panels.map((panel, index) => (
        <article class={`path path--${panel.track} block-${panel.track}`} aria-labelledby={`path-${panel.track}-title`}>
          <div class="path-inner">
            <p class="path-label">
              <span class="path-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="path-track">{panel.label}</span>
            </p>
            <h2 id={`path-${panel.track}-title`}>{panel.heading}</h2>
            <p class="path-pitch">{panel.body}</p>
            <p class="eyebrow eyebrow--status path-status">{panel.status}</p>
            <a href={panel.ctaHref} class={`btn ${panel.track === 'tech' ? 'btn-tech' : 'btn-primary'}`}>
              {panel.ctaLabel}
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <div class="container">
    <p class="hero-quiet">{quietBefore}<a href={quietLinkHref}>{quietLinkLabel}</a>{quietAfter}</p>
  </div>
</section>
