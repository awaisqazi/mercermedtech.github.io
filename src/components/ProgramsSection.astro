---
import '../styles/components/programs.css';
import Lockup from './Lockup.astro';

interface Props {
  heading: string;
  intro: string;
}

const { heading, intro } = Astro.props;
---

<section id="programs" class="programs-section">
  <div class="container">
    <div class="section-header text-center">
      <Lockup variant="eyebrow" />
      <h2>{heading}</h2>
      <p class="text-muted">{intro}</p>
    </div>
  </div>

  <!-- Two tracks, stacked: the Med catalogue on paper first, then the Tech
       track as a full-bleed indigo block. Each child brings its own
       container so the Tech block can run edge to edge. -->
  <slot />
</section>
