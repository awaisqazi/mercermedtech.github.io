---
import '../styles/components/announce.css';

interface Props {
  label: string;
  message: string;
  ctaLabel: string;
  ctaHref: string;
}

const { label, message, ctaLabel, ctaHref } = Astro.props;
---

<div class="announce-strip" aria-label={label}>
  <div class="container">
    <p>
      <i class="fas fa-bullhorn" aria-hidden="true"></i>
      <span>{message}</span>
      <a href={ctaHref}>{ctaLabel}</a>
    </p>
  </div>
</div>
