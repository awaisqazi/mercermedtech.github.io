---
/**
 * The language switch: "[ EN ] ES". The current language sits in the small
 * bracket, filled in ink; the other is a plain link to the same page in that
 * language, so it works with JavaScript switched off. The small script below
 * only carries the query and the #section across, so the switch keeps your
 * place. Each option is a 44px target.
 */
import { alternatePaths, localeMeta, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Language-free path of this page, for example "/digital-literacy/". */
  path: string;
  /** "dlt" uses the Tech-track colours. */
  variant?: 'home' | 'dlt';
}

const { locale, path, variant = 'home' } = Astro.props;
const d = t(locale);
const options = alternatePaths(path);
---

<div class={`lang-switch lang-switch--${variant}`} role="group" aria-label={d.ui.languageLabel}>
  {
    options.map(({ locale: optionLocale, path: optionPath }) => {
      const current = optionLocale === locale;
      return current ? (
        <span class="lang-switch-option lang-switch-option--current" aria-current="true" lang={localeMeta[optionLocale].htmlLang}>
          <abbr title={d.ui.thisLanguage}>{d.ui.thisLanguageCode}</abbr>
        </span>
      ) : (
        <a
          class="lang-switch-option"
          href={optionPath}
          lang={localeMeta[optionLocale].htmlLang}
          hreflang={localeMeta[optionLocale].hreflang}
          aria-label={d.ui.switchAria}
          data-lang-link
        >
          {d.ui.otherLanguageCode}
        </a>
      );
    })
  }
</div>

<script>
  // Carry the current query (?pid=, ?return=) and #section across when the
  // reader switches language.
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]').forEach((link) => {
    link.addEventListener('click', () => {
      link.href = `${link.pathname}${window.location.search}${window.location.hash}`;
    });
  });
</script>
