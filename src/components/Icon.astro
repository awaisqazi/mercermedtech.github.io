---
/**
 * The few icons the public pages use (design.md, section 8: contact rows,
 * footer, social, external link, form status), as inline SVG. They replace
 * the Font Awesome font on these pages, which saved a 54 KB stylesheet and
 * two icon fonts. Line icons on a 24px grid in the style of Feather (MIT),
 * drawn in currentColor, 1em square, hidden from screen readers.
 */
interface Props {
  name: 'phone' | 'mail' | 'map-pin' | 'check-circle' | 'alert-circle' | 'calendar-check' | 'external-link' | 'facebook' | 'instagram';
  class?: string;
  /** Rendered but not shown (the form status swaps between two icons). */
  hidden?: boolean;
}

const { name, class: className, hidden = false } = Astro.props;
// `hidden` is a global HTML attribute that SVG honours, but it is not in
// Astro's SVG attribute types, so it is passed through untyped.
const extra: Record<string, unknown> = hidden ? { hidden: true } : {};

const paths: Record<Props['name'], string> = {
  phone:
    '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>',
  'map-pin': '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
  'check-circle': '<circle cx="12" cy="12" r="10"/><path d="m8 12.5 2.8 2.8L16.5 9.5"/>',
  'alert-circle': '<circle cx="12" cy="12" r="10"/><path d="M12 7.5v5.5"/><path d="M12 16.5h.01"/>',
  'calendar-check':
    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  'external-link': '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/>',
  facebook: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>',
};
---

<svg
  class:list={['icon', `icon--${name}`, className]}
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...extra}
  set:html={paths[name]}
/>
