---
import '../styles/components/why.css';

interface Props {
  badge: string;
  heading: string;
  intro: string;
  cards: { icon: string; heading: string; body: string }[];
  admissions: {
    heading: string;
    intro: string;
    items: { icon: string; title: string; body: string }[];
    ctaHref: string;
    ctaLabel: string;
    meta: string;
    metaLinkLabel: string;
    metaLinkHref: string;
  };
}

const { badge, heading, intro, cards, admissions } = Astro.props;
---

<section id="why" class="why-section section-padding block-med">
  <div class="container">
    <div class="section-header text-center">
      <span class="eyebrow">{badge}</span>
      <h2>{heading}</h2>
      <p class="text-muted">{intro}</p>
    </div>

    <div class="why-grid">
      {
        cards.map((card) => (
          <div class="why-card">
            <h3>{card.heading}</h3>
            <p>{card.body}</p>
          </div>
        ))
      }
    </div>

    <div class="admissions-block panel-paper">
      <div class="admissions-header">
        <h3>{admissions.heading}</h3>
        <p>{admissions.intro}</p>
      </div>
      <ul class="admissions-list">
        {
          admissions.items.map((item) => (
            <li>
              <div>
                <strong>{item.title}</strong>
                <span>{item.body}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="admissions-cta">
        <a href={admissions.ctaHref} class="btn btn-primary">{admissions.ctaLabel}</a>
        <span class="meta">
          {admissions.meta}{' '}
          <a href={admissions.metaLinkHref}>{admissions.metaLinkLabel}</a>.
        </span>
      </div>
    </div>
  </div>
</section>
