---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  variant?: 'med' | 'tech';
  label: string;
  ariaLabel: string;
}

const { variant = 'med', label, ariaLabel } = Astro.props;
---

<a
  href={site.phone.href}
  class={`floating-call${variant === 'tech' ? ' floating-call--tech' : ''}`}
  aria-label={ariaLabel}
>
  <Icon name="phone" />
  <span>{label}</span>
</a>
