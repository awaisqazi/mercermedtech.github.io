---
import '../styles/components/organizations.css';

interface Props {
  heading: string;
  intro: string;
  organizations: string[];
}

const { heading, intro, organizations } = Astro.props;
// The list is printed twice so the marquee loops without a visible seam.
const marquee = [...organizations, ...organizations];
---

<section id="organizations" class="section-padding bg-surface-1">
  <div class="container">
    <div class="section-header text-center">
      <h2>{heading}</h2>
      <p class="text-muted">{intro}</p>
    </div>
    <div class="scrolling-wrapper">
      <div class="scrolling-content">
        {marquee.map((name) => <div class="org-item"><p>{name}</p></div>)}
      </div>
    </div>
  </div>
</section>
