---
import '../styles/components/organizations.css';

interface Props {
  heading: string;
  intro: string;
  organizations: string[];
}

const { heading, intro, organizations } = Astro.props;

---

<section id="organizations" class="section-padding bg-surface-1">
  <div class="container">
    <div class="section-header text-center">
      <h2>{heading}</h2>
      <p class="text-muted">{intro}</p>
    </div>
    <ul class="org-list">
      {organizations.map((name) => <li>{name}</li>)}
    </ul>
  </div>
</section>
