---
/**
 * Laptop loaner agreement page for Digital Literacy Training participants,
 * in one language.
 *
 * Hidden on purpose: BaseLayout carries "standalone" (noindex, no hreflang
 * pair) and astro.config.mjs keeps /loaner/ out of the sitemap. Nothing on the
 * site links here; staff open it with the participant at laptop pickup.
 *
 * The form is our own (StaffForm.astro, fields and the IT Asset Agreement
 * Form v2.0 rules in src/data/staffForms.ts). On submit the browser posts the
 * answers and the Turnstile token to the mmt-signup Worker
 * (POST /loaner-submit), which forwards them to the Google Form (Worker
 * variable LOANER_FORM_ACTION). The policy PDF is
 * public/loaner/IT-Asset-Policy-v2.1.pdf,
 * linked only from this page. On submit, the school's Apps Script files the
 * signed agreement in the participant's IEP folder and ticks "Laptop issued".
 *
 * Tech-track header and the minimal Tech-track footer (which carries the NJDOL
 * funding sentence), as on the IEP intake page.
 */
import '../styles/components/dl.css';
import '../styles/components/signup.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import StaffForm from '../components/StaffForm.astro';
import { LOANER_ACK, LOANER_FORM, LOANER_RULES, POLICY_PDF } from '../data/staffForms';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = t(locale).loaner;
const path = '/loaner/';
let ruleNumber = 0;
---

<BaseLayout
  locale={locale}
  path={path}
  title={page.seo.title}
  description={page.seo.description}
  variant="dlt"
  footer="dlt"
  bodyClass="dl-page signup-page loaner-page staff-form-page"
  navLinks={[]}
  standalone
>
  <main id="main" class="signup-main">
    <div class="signup-column">
      <span class="signup-eyebrow">{page.eyebrow}</span>
      <h1>{page.heading}</h1>
      <p class="signup-lead">{page.lead}</p>

      <p class="loaner-policy">
        <i class="fas fa-file-pdf" aria-hidden="true"></i>
        <span>{page.policyBefore}<a href={POLICY_PDF} target="_blank" rel="noopener">{page.policyLink}</a></span>
      </p>

      <StaffForm
        locale={locale}
        form={LOANER_FORM}
        submitLabel={page.submit}
        successTitle={page.successTitle}
        successBody={page.successBody}
        agreementAt={2}
      >
        <section class="staff-rules" slot="agreement" aria-labelledby="loaner-rules-title">
          <h3 id="loaner-rules-title">{page.agreementHeading}</h3>
          <p>{page.agreementHelp}</p>
          {
            LOANER_RULES.map((group) => (
              <details>
                <summary>{group.title[locale]}</summary>
                <ol start={ruleNumber + 1}>
                  {group.rules.map((rule) => {
                    ruleNumber += 1;
                    return <li>{rule[locale]}</li>;
                  })}
                </ol>
              </details>
            ))
          }
          <p class="staff-ack">
            <strong>{page.ackHeading}</strong>
            {LOANER_ACK[locale]}
          </p>
        </section>
      </StaffForm>
    </div>
  </main>
</BaseLayout>

<style>
  .loaner-policy {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    margin: 0 0 1rem;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    background: var(--tech-light);
    color: var(--text-dark, #1e293b);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .loaner-policy i {
    color: var(--tech-dark);
  }

  .loaner-policy a {
    color: var(--tech-dark);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
