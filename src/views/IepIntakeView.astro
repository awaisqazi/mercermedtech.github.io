---
/**
 * IEP intake page for Digital Literacy Training participants, in one language.
 *
 * Hidden on purpose: BaseLayout carries "standalone" (noindex, no hreflang
 * pair) and astro.config.mjs keeps /iep/ out of the sitemap. Nothing on the
 * site links here; staff open it with the participant at Day 0.
 *
 * The Google Form address is NOT in this page. The page shows a Cloudflare
 * Turnstile check first, posts the token to the mmt-signup Worker
 * (POST /iep-form), and the Worker answers with the form's embed URL, which
 * becomes the iframe's src. Until the Worker is deployed with IEP_FORM_URL,
 * or if the check fails, the reader sees the fallback line and a retry button.
 *
 * On form submit, the school's Apps Script makes the participant's Drive
 * folder, the prefilled IEP and the weekly note files, and adds the tracker
 * row (see MMT Management WorkSpace/Participants/IEP intake/README.md).
 *
 * Tech-track header and the minimal Tech-track footer, as on the landing page.
 * That footer carries the NJDOL funding sentence (Spanish rendering first on
 * /es/), so the page body does not repeat it.
 * navLinks is empty: the Tech-track nav anchors exist only on the landing page.
 */
import '../styles/components/dl.css';
import '../styles/components/signup.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = t(locale).iepIntake;
const path = '/iep/';

/** Public Turnstile site key, the same widget the sign-up page uses. The secret lives only in the Worker. */
const TURNSTILE_SITEKEY = '0x4AAAAAAFABG_uSmI7QN2sd';
---

<BaseLayout
  locale={locale}
  path={path}
  title={page.seo.title}
  description={page.seo.description}
  variant="dlt"
  footer="dlt"
  bodyClass="dl-page signup-page iep-page"
  navLinks={[]}
  standalone
>
  <main id="main" class="signup-main">
    <div class="signup-column iep-column">
      <span class="signup-eyebrow">{page.eyebrow}</span>
      <h1>{page.heading}</h1>
      <p class="signup-lead">{page.lead}</p>

      <section
        class="iep-gate"
        id="iep-gate"
        data-sitekey={TURNSTILE_SITEKEY}
        data-language={locale}
        aria-live="polite"
      >
        <p class="iep-status" id="iep-status">{page.checking}</p>
        <div class="signup-turnstile" id="iep-turnstile"></div>
        <p class="iep-status iep-status-error" id="iep-error" hidden>{page.fallback}</p>
        <button type="button" class="btn btn-tech iep-retry" id="iep-retry" hidden>{page.retry}</button>
        <noscript><p class="iep-status iep-status-error">{page.noscript}</p></noscript>
      </section>

      <div class="iep-frame" id="iep-frame" data-title={page.iframeTitle} data-loading={page.loading} hidden></div>
    </div>
  </main>
</BaseLayout>

<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>

<script>
  /*
   * Turnstile first, then ask the Worker for the form's embed URL and load it
   * in the iframe. The URL is only accepted if it is a Google Forms address.
   */
  const ENDPOINT = 'https://mmt-signup.mercermedtech.workers.dev/iep-form';
  const TIMEOUT_MS = 12000;
  const WAIT_FOR_SCRIPT_MS = 10000;
  const FORM_URL = /^https:\/\/docs\.google\.com\/forms\//;

  const gate = document.getElementById('iep-gate');
  const host = document.getElementById('iep-turnstile');
  const status = document.getElementById('iep-status');
  const error = document.getElementById('iep-error');
  const retry = document.getElementById('iep-retry') as HTMLButtonElement | null;
  const frame = document.getElementById('iep-frame');

  if (gate && host && status && error && retry && frame) {
    const turnstileApi = () => (window as any).turnstile;
    let widgetId: string | undefined;
    let busy = false;

    const fail = () => {
      busy = false;
      status.hidden = true;
      error.hidden = false;
      retry.hidden = false;
    };

    const openForm = (url: string) => {
      const iframe = document.createElement('iframe');
      iframe.src = url;
      iframe.title = frame.dataset.title || '';
      iframe.loading = 'eager';
      iframe.setAttribute('referrerpolicy', 'no-referrer');
      frame.replaceChildren(iframe);
      frame.hidden = false;
      gate.hidden = true;
    };

    const requestForm = async (token: string) => {
      if (busy) return;
      busy = true;
      status.textContent = frame.dataset.loading || '';
      status.hidden = false;
      error.hidden = true;
      retry.hidden = true;

      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), TIMEOUT_MS);
      try {
        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token }),
          signal: controller.signal,
        });
        const data = await response.json().catch(() => null);
        if (response.ok && data && typeof data.url === 'string' && FORM_URL.test(data.url)) {
          openForm(data.url);
          return;
        }
        fail();
      } catch {
        fail();
      } finally {
        window.clearTimeout(timer);
      }
    };

    const renderWidget = () => {
      widgetId = turnstileApi().render(host, {
        sitekey: gate.dataset.sitekey,
        theme: 'light',
        language: gate.dataset.language === 'es' ? 'es' : 'en',
        callback: (token: string) => {
          requestForm(token);
        },
        'error-callback': () => {
          fail();
        },
        'expired-callback': () => {
          if (frame.hidden) fail();
        },
      });
    };

    retry.addEventListener('click', () => {
      error.hidden = true;
      retry.hidden = true;
      status.hidden = false;
      const api = turnstileApi();
      if (api && widgetId !== undefined) {
        api.reset(widgetId);
      } else {
        window.location.reload();
      }
    });

    const startedAt = Date.now();
    const waitForTurnstile = () => {
      const api = turnstileApi();
      if (api && typeof api.render === 'function') {
        renderWidget();
        return;
      }
      if (Date.now() - startedAt > WAIT_FOR_SCRIPT_MS) {
        fail();
        return;
      }
      window.setTimeout(waitForTurnstile, 150);
    };
    waitForTurnstile();
  }
</script>

<style>
  .iep-gate {
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 1rem;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 12px;
    background: #fff;
    text-align: center;
  }

  .iep-gate[hidden],
  .iep-frame[hidden],
  .iep-status[hidden],
  .iep-retry[hidden] {
    display: none;
  }

  .iep-status {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .iep-status-error {
    color: #b02a37;
    font-weight: 600;
  }

  .iep-retry {
    margin-top: 0.75rem;
  }

  .iep-frame {
    margin: 1.5rem 0 2rem;
  }

  .iep-frame :global(iframe) {
    display: block;
    width: 100%;
    min-height: 1800px;
    border: 0;
    border-radius: 12px;
    background: #fff;
  }

  @media (max-width: 640px) {
    .iep-frame :global(iframe) {
      min-height: 2200px;
    }
  }
</style>
