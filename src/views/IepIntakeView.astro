---
/**
 * IEP intake page for Digital Literacy Training participants, in one language.
 *
 * Hidden on purpose: BaseLayout carries "standalone" (noindex, no hreflang
 * pair) and astro.config.mjs keeps /iep/ out of the sitemap. Nothing on the
 * site links here; staff open it with the participant at Day 0.
 *
 * The Google Form address is NOT in this page. The page shows a Cloudflare
 * Turnstile check first, posts the token to the mmt-signup Worker
 * (POST /iep-form), and the Worker answers with the form's embed URL, which
 * becomes the iframe's src. Until the Worker is deployed with IEP_FORM_URL,
 * or if the check fails, the reader sees the fallback line and a retry button.
 *
 * On form submit, the school's Apps Script makes the participant's Drive
 * folder, the prefilled IEP and the weekly note files, and adds the tracker
 * row (see MMT Management WorkSpace/Participants/IEP intake/README.md).
 *
 * Tech-track header and the minimal Tech-track footer, as on the landing page.
 * That footer carries the NJDOL funding sentence (Spanish rendering first on
 * /es/), so the page body does not repeat it.
 * navLinks is empty: the Tech-track nav anchors exist only on the landing page.
 */
import '../styles/components/dl.css';
import '../styles/components/signup.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import GatedGoogleForm from '../components/GatedGoogleForm.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = t(locale).iepIntake;
const path = '/iep/';
---

<BaseLayout
  locale={locale}
  path={path}
  title={page.seo.title}
  description={page.seo.description}
  variant="dlt"
  footer="dlt"
  bodyClass="dl-page signup-page iep-page"
  navLinks={[]}
  standalone
>
  <main id="main" class="signup-main">
    <div class="signup-column iep-column">
      <span class="signup-eyebrow">{page.eyebrow}</span>
      <h1>{page.heading}</h1>
      <p class="signup-lead">{page.lead}</p>

      <GatedGoogleForm
        locale={locale}
        endpoint="https://mmt-signup.mercermedtech.workers.dev/iep-form"
        text={page}
      />
    </div>
  </main>
</BaseLayout>
