---
/**
 * MMT Workbench — the staff portal.
 *
 * This page deliberately does NOT use the marketing BaseLayout: no header,
 * no footer, no language switch, no SEO metadata. It is a single-page app
 * shell that hash-routes itself (#/login, #/tasks, #/hours, ...) so it works
 * on static hosting with no server rewrites.
 *
 * English only and noindex,nofollow: the portal is behind a login and has no
 * Spanish twin, which is why the bilingual and SEO check scripts skip /admin/.
 * No project content, staff names or secrets live in this repo; everything the
 * portal shows arrives from Supabase after sign-in, behind row level security.
 */
import { getImage } from 'astro:assets';
import logo from '../../assets/images/logo-modern.png';
import AdminApp from '../../admin/AdminApp';
import '../../styles/fonts.css';
import '../../admin/styles/workbench.css';
/* One file per feature, so the screens can be styled in parallel without
   two people editing one file. Order matches src/admin/features/. */
import '../../admin/styles/features/home.css';
import '../../admin/styles/features/tasks.css';
import '../../admin/styles/features/hours.css';
import '../../admin/styles/features/inquiries.css';
import '../../admin/styles/features/people.css';
import '../../admin/styles/features/settings.css';
import '../../admin/styles/features/activity.css';

/*
 * The island is `client:only`, so nothing inside it can import the PNG and get
 * an Astro-processed URL. The page resolves the logo here instead and hands
 * the finished src down as a prop. One emitted file covers every place the
 * portal draws it: 56px tall on the sign-in panel at 3x, everything else
 * smaller.
 */
const LOGO_WIDTH = 366;
const LOGO_HEIGHT = 120;
const logoImage = await getImage({
  src: logo,
  width: LOGO_WIDTH,
  height: LOGO_HEIGHT,
  format: 'webp',
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>MMT Workbench</title>
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="same-origin" />
    <meta name="color-scheme" content="light dark" />

    <!-- The same two faces the public site uses (Fraunces for titles and big
         numerals, Plus Jakarta Sans for the rest), served from this site
         (public/fonts, @font-face in src/styles/fonts.css) and preloaded so
         they arrive with the HTML, as BaseLayout does. No third-party
         request. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/plus-jakarta-sans-latin.woff2" crossorigin />

    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

    <script is:inline>
      // Paint the chosen theme before the app mounts so there is no flash of
      // the wrong palette. The toggle writes the same key.
      try {
        var saved = localStorage.getItem('wb.theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.wbTheme = saved;
        }
      } catch (error) {
        /* private mode: fall back to the media query */
      }
    </script>
  </head>

  <body class="wb-body">
    <!-- Removed by AdminApp the moment it mounts. Without it the page is a
         blank white rectangle while the bundle downloads. -->
    <div id="wb-boot" class="wb-boot" role="status" aria-live="polite">
      <img
        class="wb-boot-logo"
        src={logoImage.src}
        alt="Mercer Med Tech"
        width={LOGO_WIDTH}
        height={LOGO_HEIGHT}
      />
      <span class="wb-boot-text">Loading the Workbench</span>
    </div>
    <AdminApp
      client:only="preact"
      logoSrc={logoImage.src}
      logoWidth={LOGO_WIDTH}
      logoHeight={LOGO_HEIGHT}
    />
    <noscript>
      <p class="wb-boot-text">The Workbench needs JavaScript switched on.</p>
    </noscript>
  </body>
</html>
